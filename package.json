{
  "name": "focus-flow",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "FocusFlow — a focus timer (Pomodoro technique) with site blocking, focus sounds and gamified stats.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build && node scripts/package.mjs",
    "package": "node scripts/package.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.525.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "webextension-polyfill": "^0.12.0",
    "@fontsource-variable/inter": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.1.43",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@vitejs/plugin-react": "^4.5.2",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  }
}
